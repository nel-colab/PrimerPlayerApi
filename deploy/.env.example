# Copiar a /opt/runagard/deploy/.env en el VPS y completar. NUNCA subir .env a git (ya está en .gitignore).
# Generar claves en el servidor:   openssl rand -base64 32
# Valores con $ (hash de Caddy): entre comillas SIMPLES, o docker compose intenta interpretarlos.

# ---------- general ----------
DOMINIO=runagard.cl
ACME_EMAIL=tu-correo@ejemplo.cl          # Let's Encrypt avisa aquí si un certificado tiene problemas

# ---------- base de datos de la tienda ----------
POSTGRES_DB=runagard
POSTGRES_USER=runagard
POSTGRES_PASSWORD=                       # openssl rand -base64 24 | tr -d '/+='

# ---------- MinIO (imágenes y comprobantes) ----------
MINIO_ROOT_USER=runagard
MINIO_ROOT_PASSWORD=                     # openssl rand -base64 24 | tr -d '/+='   (mínimo 8 caracteres)

# ---------- API ----------
PP_AUTH_JWT_SECRETO=                     # openssl rand -base64 48   (si cambia, todos deben volver a iniciar sesión)
PP_AUTH_GOOGLE_CLIENT_ID=787872539302-5lkjcuse2s9adeu38ocjl25h89o163is.apps.googleusercontent.com

# Webpay: "integracion" (pruebas) hasta que Transbank entregue las credenciales de producción.
PP_WEBPAY_AMBIENTE=integracion
PP_WEBPAY_CODIGO_COMERCIO=
PP_WEBPAY_API_KEY=
PP_WEBPAY_URL_FORMULARIO=https://webpay3gint.transbank.cl/webpayserver/initTransaction

# Correo (Brevo, Amazon SES, etc.). El remitente debe ser del dominio verificado en el proveedor.
SPRING_MAIL_HOST=smtp-relay.brevo.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
PP_MAIL_REMITENTE="Primer Player <no-responder@runagard.cl>"
ALERTAS_REMITENTE=alertas@runagard.cl    # remitente de las alertas de Grafana

# Versión desplegada (Jenkins usa "latest"; para volver atrás: API_TAG=<commit> docker compose up -d api)
API_TAG=latest
FRONT_TAG=latest

# ---------- herramientas (jenkins., sonar., grafana.) ----------
# Primera capa de acceso (Caddy). El hash se genera con:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'TU_CLAVE'
OPS_USUARIO=equipo
OPS_PASSWORD_HASH='$2a$14$reemplazar.por.el.hash.generado'

# Jenkins
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=
DOCKER_GID=                              # getent group docker | cut -d: -f3

# GitHub: token "fine-grained" de solo lectura (Contents: Read) sobre los dos repositorios.
GITHUB_OWNER=nel-colab
GITHUB_USER=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=                   # openssl rand -hex 32 (el mismo valor va en el webhook de GitHub)

# SonarQube: se completa después del primer arranque (My Account → Security → Generate token).
SONAR_TOKEN=
SONAR_DB_PASSWORD=                       # openssl rand -base64 24 | tr -d '/+='

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
