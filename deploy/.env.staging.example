# Variables de STAGING (rama develop). Copiar a /opt/runagard/deploy/.env.staging en el VPS y completar.
# OJO: los comentarios van en su propia línea. Un "# ..." al lado del valor pasa a ser parte del valor.
# NUNCA subir .env.staging a git. Usa claves DISTINTAS de producción: si staging se filtra, producción sigue segura.
# Lo usa: docker compose -f docker-compose.staging.yml --env-file .env.staging ...

# Dominio base: staging queda en staging.<DOMINIO> y media-staging.<DOMINIO>
DOMINIO=runagard.cl

# ---------- base de datos de staging ----------
POSTGRES_DB=runagard_staging
POSTGRES_USER=runagard
# openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=

# ---------- MinIO de staging ----------
MINIO_ROOT_USER=runagard
# openssl rand -base64 24 | tr -d '/+='
MINIO_ROOT_PASSWORD=

# ---------- API ----------
# openssl rand -base64 48   (distinto al de producción)
PP_AUTH_JWT_SECRETO=
PP_AUTH_GOOGLE_CLIENT_ID=787872539302-5lkjcuse2s9adeu38ocjl25h89o163is.apps.googleusercontent.com
# Webpay: staging siempre usa integración (fijado en docker-compose.staging.yml).

# Correo: puede ser el mismo proveedor que producción. Vacío = no salen correos (la tienda funciona igual).
SPRING_MAIL_HOST=smtp-relay.brevo.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
PP_MAIL_REMITENTE="Primer Player STAGING <no-responder@runagard.cl>"

# Versión desplegada (Jenkins usa "staging"; para volver atrás: API_TAG=staging-anterior)
API_TAG=staging
FRONT_TAG=staging
