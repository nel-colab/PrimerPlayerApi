# Caddy: HTTPS automático con Let's Encrypt para todos los sitios.
# Las variables {$...} vienen de deploy/.env (ver docker-compose.yml).
# Recargar tras un cambio: docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile

{
	# Métricas de tráfico por dominio (Prometheus las lee de :2020, solo dentro de la red de Docker)
	metrics {
		per_host
	}
}

# Endpoint de métricas: el puerto 2020 no se publica en el host (docker-compose.yml solo publica 80 y 443).
:2020 {
	metrics
}

(seguridad) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}
}

# Capa extra para las herramientas internas: usuario/clave de Caddy ANTES del login propio de cada una.
# Al reenviar:
#  - se quita Authorization: Jenkins, SonarQube y Grafana lo interpretarían como su propio login (401);
#  - se quita WWW-Authenticate de las respuestas de la herramienta: con ese encabezado, un 401 de su propio login
#    (clave mal escrita) hace que el navegador crea que falló la clave de Caddy, la olvide y vuelva a pedirla.
#    El 401 se mantiene: SonarQube y Grafana lo usan para llevar a su pantalla de login.
(herramienta) {
	import seguridad
	basic_auth {
		{$OPS_USUARIO} {$OPS_PASSWORD_HASH}
	}
}

(proxy_herramienta) {
	header_up -Authorization
	header_down -WWW-Authenticate
}

# ---------- tienda ----------

{$DOMINIO} {
	import seguridad
	encode zstd gzip

	# Estado para el monitoreo externo (UptimeRobot): solo UP/DOWN, sin detalles.
	handle /salud {
		rewrite * /actuator/health/readiness
		reverse_proxy api:8081
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy front:4000
	}

	log
}

www.{$DOMINIO} {
	redir https://{$DOMINIO}{uri} permanent
}

# Sitios opcionales (p. ej. redirecciones desde runagard.store / runagard.online): cada archivo *.caddy de sitios/.
# Para activarlas: renombrar sitios/redirecciones.caddy.ejemplo a redirecciones.caddy cuando su DNS apunte al VPS.
import sitios/*.caddy

# Imágenes públicas y comprobantes con URL firmada. Solo lectura: la API escribe por la red interna.
media.{$DOMINIO} {
	import seguridad
	# Las métricas y la administración de MinIO nunca se publican (Prometheus las lee por la red interna).
	@interno path /minio/*
	handle @interno {
		respond 404
	}
	@lectura method GET HEAD
	handle @lectura {
		reverse_proxy minio:9000
	}
	handle {
		respond "Método no permitido" 405
	}
}

# ---------- herramientas ----------

jenkins.{$DOMINIO} {
	# El webhook de GitHub no puede pasar el basic_auth; Jenkins valida su firma (GITHUB_WEBHOOK_SECRET).
	@webhook path /github-webhook /github-webhook/
	handle @webhook {
		reverse_proxy jenkins:8080
	}
	handle {
		import herramienta
		reverse_proxy jenkins:8080 {
			import proxy_herramienta
		}
	}
}

sonar.{$DOMINIO} {
	import herramienta
	reverse_proxy sonarqube:9000 {
		import proxy_herramienta
	}
}

grafana.{$DOMINIO} {
	import herramienta
	reverse_proxy grafana:3000 {
		import proxy_herramienta
	}
}
