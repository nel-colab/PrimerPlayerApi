  {
   "id": 123,
   "type": "stat",
   "title": "Último build",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 12,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (jenkins_job) (default_jenkins_builds_last_build_result_ordinal)",
     "legendFormat": "{{jenkins_job}}",
     "refId": "S",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "ÉXITO",
         "color": "green"
        },
        "1": {
         "text": "INESTABLE",
         "color": "orange"
        },
        "2": {
         "text": "FALLÓ",
         "color": "red"
        },
        "3": {
         "text": "SIN CONSTRUIR",
         "color": "blue"
        },
        "4": {
         "text": "ABORTADO",
         "color": "purple"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
