  {
   "id": 98,
   "type": "stat",
   "title": "Aciertos de caché",
   "description": "Lecturas servidas desde memoria. Bajo 90 % sostenido = falta memoria compartida.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 14,
    "y": 1,
    "w": 5,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * sum(rate(pg_stat_database_blks_hit{datname=\"runagard\"}[30m])) / clamp_min(sum(rate(pg_stat_database_blks_hit{datname=\"runagard\"}[30m])) + sum(rate(pg_stat_database_blks_read{datname=\"runagard\"}[30m])), 1e-9)",
     "legendFormat": "",
     "refId": "T",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
