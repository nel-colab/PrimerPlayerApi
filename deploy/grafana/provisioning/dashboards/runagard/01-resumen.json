  {
   "id": 3,
   "type": "stat",
   "title": "Servicios caídos",
   "description": "Fuentes de métricas que Prometheus no logra leer. Debe ser 0.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(up == 0) or vector(0)",
     "legendFormat": "",
     "refId": "C",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "area",
    "justifyMode": "center",
    "textMode": "auto",
    "orientation": "auto"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Servicios",
   "description": "api = tienda (Spring Boot) · caddy = HTTPS/tráfico · postgres = base de datos · minio = imágenes · jenkins = CI/CD · vps = servidor · contenedores = Docker",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 14,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (job) (up)",
     "legendFormat": "{{job}}",
     "refId": "E",
     "instant": true,
     "range": false
