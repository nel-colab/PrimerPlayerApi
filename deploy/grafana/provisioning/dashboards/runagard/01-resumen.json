  {
   "id": 10,
   "type": "timeseries",
   "title": "Peticiones por segundo, por dominio",
   "description": "Todo el tráfico que entra por Caddy (tienda, media y herramientas).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (host) (rate(caddy_http_request_duration_seconds_count[5m]))",
     "legendFormat": "{{host}}",
     "refId": "J"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "unit": "reqps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Errores del servidor (5xx)",
   "description": "Porcentaje de respuestas con error del servidor.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 7,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * sum(rate(caddy_http_request_duration_seconds_count{code=~\"5..\"}[5m])) / clamp_min(sum(rate(caddy_http_request_duration_seconds_count[5m])), 1e-9)",
     "legendFormat": "% de respuestas 5xx",
     "refId": "L"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true
